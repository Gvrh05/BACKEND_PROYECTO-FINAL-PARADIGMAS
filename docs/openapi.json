{
  "openapi": "3.0.3",
  "info": {
    "title": "Profelink Kahoot Monolith API",
    "description": "Backend API para la plataforma interactiva tipo Kahoot en arquitectura Vertical Slice (Monolito Modular)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/kahoot-api",
      "description": "Servidor de Desarrollo Local"
    }
  ],
  "paths": {
    "/game-sessions": {
      "post": {
        "operationId": "createGameSession",
        "summary": "Crear sala con un cuestionario propio",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sala persistida en LOBBY; el host se registra una sola vez",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/game-sessions/available-quizzes": {
      "get": {
        "operationId": "listAvailableQuizzes",
        "summary": "Listar solo quizzes propios para el selector del host",
        "description": "Filtra por sub del JWT mediante findAllByOwner; no llama al mock público GET /quizzes ni expone preguntas/respuestas.",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Catálogo propio; puede ser []",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AvailableQuiz" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/game-sessions/{roomCode}": {
      "get": {
        "operationId": "getSessionByCode",
        "summary": "Recuperar snapshot de una sala para reconexión",
        "description": "No registra al solicitante ni cambia la fase. El lobby en memoria debe existir en el proceso actual.",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RoomCode" }],
        "responses": {
          "200": {
            "description": "Estado actual de esta sala",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SessionSnapshot" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/game-sessions/{roomCode}/participants": {
      "get": {
        "operationId": "listSessionParticipants",
        "summary": "Listar participantes de una sola sala",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RoomCode" }],
        "responses": {
          "200": {
            "description": "Host y jugadores sin tokens, sockets, respuestas ni puntajes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Participant" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/game-sessions/{roomCode}/join": {
      "post": {
        "operationId": "joinSession",
        "summary": "Unirse o actualizar un participante por sub, idempotentemente",
        "description": "Nuevo jugador solo en LOBBY. Una identidad existente puede reconectar en IN_PROGRESS. REST por sí solo no marca connected=true; eso requiere WS.",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RoomCode" }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/JoinSessionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "added=false si ya existía la identidad; nunca la duplica",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JoinSessionResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/game-sessions/{roomCode}/start": {
      "post": {
        "operationId": "startSession",
        "summary": "Iniciar la sala, exclusivamente como anfitrión",
        "description": "Solo LOBBY → IN_PROGRESS; persiste status/startedAt y notifica session-started a la sala para inicios REST o WS. El botón UI requiere otro jugador conectado; la autorización del endpoint compara sub con hostId.",
        "tags": ["GameSessions"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/RoomCode" }],
        "responses": {
          "200": {
            "description": "Inicio persistido exactamente una vez",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StartedSession" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/quizzes": {
      "get": {
        "summary": "Listar cuestionarios",
        "tags": ["Quizzes"],
        "responses": {
          "200": {
            "description": "Lista de cuestionarios obtenida con éxito"
          }
        }
      },
      "post": {
        "summary": "Crear un nuevo cuestionario",
        "tags": ["Quizzes"],
        "responses": {
          "201": {
            "description": "Cuestionario creado con éxito"
          }
        }
      }
    },
    "/results/{pin}": {
      "get": {
        "summary": "Obtener resultados de una sesión por PIN",
        "tags": ["Results"],
        "parameters": [
          {
            "name": "pin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resultados de la sesión"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firma HS256 y secreto compartido solo dev/demo; requiere sub y valida expiración e issuer/audience configurados."
      }
    },
    "parameters": {
      "RoomCode": {
        "name": "roomCode",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/RoomCode" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validación inválida, sala ya iniciada para un jugador nuevo o fase distinta de LOBBY para iniciar",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError" }
          }
        }
      },
      "Unauthorized": {
        "description": "JWT ausente, inválido, expirado o sin sub válido",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError" }
          }
        }
      },
      "Forbidden": {
        "description": "Quiz inexistente/ajeno al crear, o solicitante distinto del host al iniciar",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError" }
          }
        }
      },
      "NotFound": {
        "description": "No existe un lobby activo para ese código en este proceso",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError" }
          }
        }
      },
      "InternalError": {
        "description": "Error del servidor sin datos sensibles",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/HttpError" }
          }
        }
      }
    },
    "schemas": {
      "RoomCode": {
        "type": "string",
        "pattern": "^\\d{6}$",
        "minLength": 6,
        "maxLength": 6,
        "example": "123456"
      },
      "SessionStatus": {
        "type": "string",
        "enum": ["LOBBY", "IN_PROGRESS", "FINISHED"]
      },
      "CreateSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quizId"],
        "properties": {
          "quizId": { "type": "string", "format": "uuid", "minLength": 1 }
        }
      },
      "JoinSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S",
            "description": "Opcional; se recortan espacios. Si falta se conserva nombre existente o se asigna un alias."
          }
        }
      },
      "Participant": {
        "type": "object",
        "additionalProperties": false,
        "required": ["userId", "name", "connected"],
        "properties": {
          "userId": { "type": "string" },
          "name": { "type": "string" },
          "connected": {
            "type": "boolean",
            "description": "Presencia WS; no basta un join REST"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": ["sessionId", "roomCode", "status", "hostId", "quizId"],
        "properties": {
          "sessionId": { "$ref": "#/components/schemas/RoomCode" },
          "roomCode": { "$ref": "#/components/schemas/RoomCode" },
          "status": { "$ref": "#/components/schemas/SessionStatus" },
          "hostId": {
            "type": "string",
            "description": "sub verificado del anfitrión"
          },
          "quizId": { "type": "string", "format": "uuid" }
        }
      },
      "SessionSnapshot": {
        "allOf": [
          { "$ref": "#/components/schemas/Session" },
          {
            "type": "object",
            "required": ["participants"],
            "properties": {
              "participants": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Participant" }
              },
              "startedAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "StartedSession": {
        "allOf": [
          { "$ref": "#/components/schemas/Session" },
          {
            "type": "object",
            "required": ["startedAt"],
            "properties": {
              "startedAt": { "type": "string", "format": "date-time" }
            }
          }
        ]
      },
      "AvailableQuiz": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" }
        }
      },
      "JoinSessionResponse": {
        "type": "object",
        "required": ["added", "player"],
        "properties": {
          "added": { "type": "boolean" },
          "player": { "$ref": "#/components/schemas/Participant" }
        }
      },
      "HttpError": {
        "type": "object",
        "required": ["statusCode", "timestamp", "path", "error"],
        "properties": {
          "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 },
          "timestamp": { "type": "string", "format": "date-time" },
          "path": { "type": "string" },
          "error": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "message": {
                    "oneOf": [
                      { "type": "string" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  },
                  "error": { "type": "string" },
                  "statusCode": { "type": "integer" }
                }
              }
            ]
          }
        }
      },
      "WsRoomPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roomCode"],
        "properties": {
          "roomCode": { "$ref": "#/components/schemas/RoomCode" }
        }
      },
      "ParticipantsUpdatedEvent": {
        "type": "object",
        "required": ["participants"],
        "properties": {
          "participants": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Participant" }
          }
        }
      },
      "SessionStartedEvent": {
        "type": "object",
        "required": ["sessionId", "startedAt"],
        "properties": {
          "sessionId": { "$ref": "#/components/schemas/RoomCode" },
          "startedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WsError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "INVALID_ROOM_CODE",
              "SESSION_NOT_FOUND",
              "SESSION_ALREADY_STARTED",
              "INVALID_SESSION_STATUS",
              "FORBIDDEN",
              "INTERNAL_ERROR"
            ]
          },
          "message": { "type": "string" }
        }
      }
    }
  },
  "x-websocket": {
    "transport": "Socket.IO (no WebSocket nativo)",
    "url": "http://localhost:3000/game",
    "namespace": "/game",
    "authentication": "handshake.auth.token; mismas reglas JWT que REST. Token inválido desconecta. Se revalida en mensajes.",
    "isolation": "Solo server.to(roomCode) o server.to(socketId); nunca broadcast global.",
    "events": {
      "join-session": {
        "direction": "client-to-server",
        "auth": "JWT",
        "payload": { "$ref": "#/components/schemas/WsRoomPayload" }
      },
      "session-state": {
        "direction": "server-to-socket",
        "payload": { "$ref": "#/components/schemas/SessionSnapshot" }
      },
      "participants-updated": {
        "direction": "server-to-room",
        "payload": { "$ref": "#/components/schemas/ParticipantsUpdatedEvent" }
      },
      "start-session": {
        "direction": "client-to-server",
        "auth": "JWT + sub === hostId",
        "payload": { "$ref": "#/components/schemas/WsRoomPayload" }
      },
      "session-started": {
        "direction": "server-to-room",
        "payload": { "$ref": "#/components/schemas/SessionStartedEvent" }
      },
      "error": {
        "direction": "server-to-socket",
        "payload": { "$ref": "#/components/schemas/WsError" }
      }
    }
  }
}
