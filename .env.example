# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kahoot_db?schema=public

# Optional manual persistence check; use only local kahoot_punto3_test.
# If empty, pnpm test:persistence derives/prepares that dedicated DB from DATABASE_URL.
TEST_DATABASE_URL=

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ISSUER=kahoot-auth-dev
JWT_AUDIENCE=kahoot-game
AUTH_SERVICE_URL=http://localhost:4000/auth

# Observability (stub; the OTel teammate will install the real SDK)
OTEL_SERVICE_NAME=kahoot-game-session
OTEL_EXPORTER_OTLP_ENDPOINT=

# Uploads Configuration
UPLOADS_DEST=./public/uploads
MAX_FILE_SIZE=5242880
