# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://kahoot:replace-with-local-monolith-db-password@localhost:5432/kahoot_db?schema=public
POSTGRES_PORT=5432
POSTGRES_USER=kahoot
POSTGRES_PASSWORD=replace-with-local-monolith-db-password
POSTGRES_DB=kahoot_db

# Auth uses a different PostgreSQL database/container
AUTH_POSTGRES_PORT=5433
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=replace-with-local-auth-db-password
AUTH_POSTGRES_DB=auth_db

# Optional manual persistence check; use only local kahoot_punto3_test.
# If empty, pnpm test:persistence derives/prepares that dedicated DB from DATABASE_URL.
TEST_DATABASE_URL=

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production
# Optional issuer validation. Set only if the identity service emits this issuer.
JWT_ISSUER=
JWT_AUDIENCE=kahoot-api
OTEL_SERVICE_NAME=kahoot-game-session
OTEL_EXPORTER_OTLP_ENDPOINT=

# Uploads Configuration
UPLOADS_DEST=./uploads
MAX_FILE_SIZE=5242880
AUTH_SERVICE_URL=http://localhost:3001/auth
AUTH_PORT=3001
DEMO_USER_USERNAME=profesor_test
DEMO_USER_PASSWORD=replace-with-a-local-demo-password

# Browser-facing URLs baked into the frontend image
VITE_API_URL=http://localhost:3000/kahoot-api
VITE_AUTH_API_URL=http://localhost:3001/auth
FRONTEND_PORT=5173
